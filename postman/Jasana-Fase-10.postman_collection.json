          "name": "Daftar notifikasi: hanya IN_APP milik sendiri, terbaru dulu, unread_count",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('Tiga IN_APP, tanpa baris EMAIL', function () { pm.expect(body.data.map(function (n) { return n.title; })).to.eql(['Demo tiga', 'Demo dua', 'Demo satu']); });",
                  "pm.test('Meta paginasi dan unread_count', function () { pm.expect(body.meta).to.eql({ page: 1, limit: 20, total: 3, unread_count: 2 }); });",
                  "pm.test('Bentuk DTO', function () { pm.expect(body.data[0]).to.have.all.keys('id', 'type', 'title', 'body', 'reference_type', 'reference_id', 'is_read', 'read_at', 'created_at'); pm.expect(body.data[0].id).to.be.a('string'); });",
                  "pm.environment.set('f10_notif_satu', body.data[2].id);"
                ]
              }
            }
