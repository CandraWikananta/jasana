enum UserRole {
  CLIENT
  ADMIN

  @@map("user_role")
}

/// DRAFT = baru klik ajukan, dokumen belum lengkap (belum masuk antrean admin).
/// PENDING = dokumen wajib lengkap, benar-benar menunggu pemeriksaan admin.
enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

