# Salin ke .env.local. Seluruh variabel wajib, aplikasi gagal start kalau ada yang kosong (PRD Frontend 9.4).
# Hanya NEXT_PUBLIC_* yang sampai ke browser, jangan taruh secret di sana.
# Origin dev server Next (http://localhost:3100) harus ada di CORS_ORIGIN backend.

# URL REST API untuk browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# URL Socket.IO (server Express yang sama)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# URL REST API untuk Route Handler /api/session/* (server ke server). Saat deploy, pakai jalur
# dengan jumlah hop proxy yang sama dengan jalur publik, supaya TRUST_PROXY backend (D117)
# membaca IP pengguna dari X-Forwarded-For, bukan IP server Next.
API_INTERNAL_BASE_URL=http://localhost:3000/api/v1
# Nama cookie httpOnly refresh token (Path=/api/session)
SESSION_COOKIE_NAME=jasana_refresh
# true di staging dan produksi (HTTPS). false hanya untuk http://localhost
SESSION_COOKIE_SECURE=false
